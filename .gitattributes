# Keep line endings stable across tools.
* text=auto eol=lf
*.html text eol=lf
*.manifest text eol=lf
# Windows-only build files keep Windows line endings: cmd.exe misreads a
# batch file with bare LF line endings, and the other two follow suit.
# Images are never touched: the app icon must stay byte-for-byte the file it
# was copied from.
*.ico binary
*.png binary
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.iss text eol=crlf
