<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Application manifest for the packaged The Ox .exe.

  Declaring per-monitor DPI awareness v2 here, rather than calling
  SetProcessDpiAwarenessContext at runtime, is what Microsoft recommends and
  is the only way to be aware before the first window exists. Setting it in
  code also made Qt's own call fail with "Access is denied", because the
  process awareness was already fixed by the time Qt asked.

  v2 means: each monitor's own scale factor applies, the app is told when a
  window moves between monitors, and non-client areas scale too, so the
  strip is correct on monitors with different scale settings at once.

  packaging\build.ps1 embeds this in "The Ox Tracker.exe". It does not use
  this file as it stands: it copies it into build\, replacing the version
  below with the one in the_ox\__init__.py, which is the only place the
  version number is kept. The 0.0.0.0 here is a placeholder, and the build
  refuses to continue if the placeholder is not found.

  No requestedExecutionLevel elevation: The Ox Tracker runs as a normal user
  and never needs administrator rights. Only its installer does, to write
  to Program Files.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity
      type="win32"
      name="TheOxTracker"
      version="0.0.0.0"
      processorArchitecture="amd64"/>
  <description>The Ox Tracker: local AI usage tracker</description>

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
</assembly>
